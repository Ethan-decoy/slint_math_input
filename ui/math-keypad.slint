import { ScrollView } from "std-widgets.slint";
import { MathCatalog, CatalogKey } from "math-catalog.slint";
import "../assets/STIXTwoMath-Regular.ttf";
struct KeySpec { label: string, value: string, description: string }

component MathKeyButton inherits Rectangle {
    in property <string> label;
    in property <string> description: label;
    in property <bool> primary;
    in property <bool> compact;
    in property <bool> math-label;
    in property <bool> enabled: true;
    in property <bool> checkable;
    in-out property <bool> checked;
    callback clicked();
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: description;
    accessible-enabled: enabled;
    accessible-checkable: checkable;
    accessible-checked: checked;
    accessible-action-default => { root.activate(); }
    private property <bool> highlighted: primary || checked;
    // Opaque local colors stay legible when a host uses a dark system palette.
    background: !enabled ? #e4e9ee : highlighted ? (touch.pressed ? #10466b : touch.has-hover ? #145884 : #17659d) : (touch.pressed ? #d9e6f0 : touch.has-hover ? #edf4f9 : white);
    border-radius: 4px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? #1166a2 : highlighted ? #17659d : #aabac6;
    function activate() {
        if root.enabled {
            if root.checkable { root.checked = !root.checked; }
            root.clicked();
        }
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        // Bundle mathematical glyphs; ordinary controls retain the host UI font.
        font-family: root.math-label ? "STIX Two Math" : "";
        font-size: root.compact || root.label == "arcsin" || root.label == "arccos" || root.label == "arctan" || root.label == "退出" || root.label == "退格" || root.label == "提交" || root.label == "行首" || root.label == "行尾" || root.label == "大小写" ? 14px : 18px;
        color: !root.enabled ? #576773 : root.highlighted ? white : #263a47;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activate();
                return accept;
            }
            return reject;
        }
    }
}

export component MathKeypad inherits Rectangle {
    // Commands beginning with "key:" are interpreted by MathInputController::keypad.
    // Literal mathematical text uses the same editing rules as physical typing.
    in-out property <int> page: 0;
    in-out property <bool> expanded: true;
    in-out property <bool> selecting: false;
    in-out property <bool> uppercase: false;
    in-out property <int> category: 0;
    in-out property <length> catalog-scroll-position: 0px;
    private property <int> active-category: Math.min(Math.max(category, 0), MathCatalog.sections.length - 1);
    private property <[CatalogKey]> catalog-keys: MathCatalog.sections[active-category].keys;
    changed category => { root.catalog-scroll-position = 0px; }
    callback key(string, bool);
    callback submitted();
    callback focus-requested();
    min-width: 640px;
    min-height: expanded ? 288px : 56px;
    max-height: self.min-height;
    preferred-height: self.min-height;
    background: #e9eef2;
    border-radius: 5px;
    border-width: 1px;
    border-color: #d5dee5;
    accessible-role: groupbox;
    accessible-label: "数学键盘";
    private property <[KeySpec]> basic: [
        {label: "x", value: "x", description: "变量 x"},
        {label: "y", value: "y", description: "变量 y"},
        {label: "a²", value: "key:square", description: "平方"},
        {label: "aᵇ", value: "key:power", description: "上标"},
        {label: "7", value: "7", description: "7"},
        {label: "8", value: "8", description: "8"},
        {label: "9", value: "9", description: "9"},
        {label: "÷", value: "key:fraction", description: "分数"},
        {label: "←", value: "key:left", description: "向左"},
        {label: "→", value: "key:right", description: "向右"},
        {label: "(", value: "(", description: "左圆括号"},
        {label: ")", value: ")", description: "右圆括号"},
        {label: "√", value: "key:root", description: "平方根"},
        {label: "π", value: "π", description: "圆周率"},
        {label: "4", value: "4", description: "4"},
        {label: "5", value: "5", description: "5"},
        {label: "6", value: "6", description: "6"},
        {label: "×", value: "*", description: "乘以"},
        {label: "↑", value: "key:up", description: "向上"},
        {label: "↓", value: "key:down", description: "向下"},
        {label: "[", value: "[", description: "左方括号"},
        {label: "]", value: "]", description: "右方括号"},
        {label: "|a|", value: "key:absolute", description: "绝对值"},
        {label: "aₙ", value: "key:subscript", description: "下标"},
        {label: "1", value: "1", description: "1"},
        {label: "2", value: "2", description: "2"},
        {label: "3", value: "3", description: "3"},
        {label: "−", value: "-", description: "减"},
        {label: "行首", value: "key:home", description: "当前行开头"},
        {label: "行尾", value: "key:end", description: "当前行结尾"},
        {label: ",", value: ",", description: "逗号"},
        {label: "≤", value: "≤", description: "小于等于"},
        {label: "≥", value: "≥", description: "大于等于"},
        {label: "退出", value: "key:next", description: "退出当前结构"},
        {label: "0", value: "0", description: "0"},
        {label: ".", value: ".", description: "小数点"},
        {label: "=", value: "=", description: "等于"},
        {label: "+", value: "+", description: "加"},
        {label: "退格", value: "key:backspace", description: "退格"},
        {label: "提交", value: "key:submit", description: "提交公式"}
    ];
    private property <[KeySpec]> letters: [
        {label: "q", value: "q", description: "字母 q"},
        {label: "w", value: "w", description: "字母 w"},
        {label: "e", value: "e", description: "字母 e"},
        {label: "r", value: "r", description: "字母 r"},
        {label: "t", value: "t", description: "字母 t"},
        {label: "y", value: "y", description: "字母 y"},
        {label: "u", value: "u", description: "字母 u"},
        {label: "i", value: "i", description: "字母 i"},
        {label: "o", value: "o", description: "字母 o"},
        {label: "p", value: "p", description: "字母 p"},
        {label: "a", value: "a", description: "字母 a"},
        {label: "s", value: "s", description: "字母 s"},
        {label: "d", value: "d", description: "字母 d"},
        {label: "f", value: "f", description: "字母 f"},
        {label: "g", value: "g", description: "字母 g"},
        {label: "h", value: "h", description: "字母 h"},
        {label: "j", value: "j", description: "字母 j"},
        {label: "k", value: "k", description: "字母 k"},
        {label: "l", value: "l", description: "字母 l"},
        {label: "_", value: "key:subscript", description: "下标"},
        {label: "z", value: "z", description: "字母 z"},
        {label: "x", value: "x", description: "字母 x"},
        {label: "c", value: "c", description: "字母 c"},
        {label: "v", value: "v", description: "字母 v"},
        {label: "b", value: "b", description: "字母 b"},
        {label: "n", value: "n", description: "字母 n"},
        {label: "m", value: "m", description: "字母 m"},
        {label: "(", value: "(", description: "左圆括号"},
        {label: ")", value: ")", description: "右圆括号"},
        {label: "退格", value: "key:backspace", description: "退格"},
        {label: "大小写", value: "key:case", description: "切换大小写"},
        {label: "x", value: "x", description: "变量 x"},
        {label: "y", value: "y", description: "变量 y"},
        {label: "n", value: "n", description: "变量 n"},
        {label: "π", value: "π", description: "圆周率"},
        {label: ",", value: ",", description: "逗号"},
        {label: "←", value: "key:left", description: "向左"},
        {label: "→", value: "key:right", description: "向右"},
        {label: "退出", value: "key:next", description: "退出当前结构"},
        {label: "提交", value: "key:submit", description: "提交公式"}
    ];
    private property <[KeySpec]> capitals: [
        {label: "Q", value: "Q", description: "字母 Q"},
        {label: "W", value: "W", description: "字母 W"},
        {label: "E", value: "E", description: "字母 E"},
        {label: "R", value: "R", description: "字母 R"},
        {label: "T", value: "T", description: "字母 T"},
        {label: "Y", value: "Y", description: "字母 Y"},
        {label: "U", value: "U", description: "字母 U"},
        {label: "I", value: "I", description: "字母 I"},
        {label: "O", value: "O", description: "字母 O"},
        {label: "P", value: "P", description: "字母 P"},
        {label: "A", value: "A", description: "字母 A"},
        {label: "S", value: "S", description: "字母 S"},
        {label: "D", value: "D", description: "字母 D"},
        {label: "F", value: "F", description: "字母 F"},
        {label: "G", value: "G", description: "字母 G"},
        {label: "H", value: "H", description: "字母 H"},
        {label: "J", value: "J", description: "字母 J"},
        {label: "K", value: "K", description: "字母 K"},
        {label: "L", value: "L", description: "字母 L"},
        {label: "_", value: "key:subscript", description: "下标"},
        {label: "Z", value: "Z", description: "字母 Z"},
        {label: "X", value: "X", description: "字母 X"},
        {label: "C", value: "C", description: "字母 C"},
        {label: "V", value: "V", description: "字母 V"},
        {label: "B", value: "B", description: "字母 B"},
        {label: "N", value: "N", description: "字母 N"},
        {label: "M", value: "M", description: "字母 M"},
        {label: "(", value: "(", description: "左圆括号"},
        {label: ")", value: ")", description: "右圆括号"},
        {label: "退格", value: "key:backspace", description: "退格"},
        {label: "大小写", value: "key:case", description: "切换大小写"},
        {label: "X", value: "X", description: "字母 X"},
        {label: "Y", value: "Y", description: "字母 Y"},
        {label: "N", value: "N", description: "字母 N"},
        {label: "π", value: "π", description: "圆周率"},
        {label: ",", value: ",", description: "逗号"},
        {label: "←", value: "key:left", description: "向左"},
        {label: "→", value: "key:right", description: "向右"},
        {label: "退出", value: "key:next", description: "退出当前结构"},
        {label: "提交", value: "key:submit", description: "提交公式"}
    ];
    private property <[KeySpec]> keys: page == 1 ? (uppercase ? capitals : letters) : basic;
    function activate(value: string) {
        if value == "key:case" {
            root.uppercase = !root.uppercase;
            root.focus-requested();
        } else if value == "key:submit" {
            root.selecting = false;
            root.submitted();
        } else {
            root.key(value, root.selecting);
            if value != "key:left" && value != "key:right" && value != "key:up" && value != "key:down" && value != "key:home" && value != "key:end" {
                root.selecting = false;
            }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            MathKeyButton { width: 64px; compact: true; label: "123"; primary: root.page == 0; clicked => { root.page = 0; root.focus-requested(); } }
            MathKeyButton { width: 64px; compact: true; label: "ABC"; primary: root.page == 1; clicked => { root.page = 1; root.focus-requested(); } }
            MathKeyButton { width: 64px; compact: true; label: "函数"; primary: root.page == 2; clicked => { root.page = 2; root.focus-requested(); } }
            Text { text: !root.expanded ? "" : root.page == 2 ? "点击分类 · 分类内滚动浏览" : "点击输入 · 在公式中点击定位"; color: #617482; font-size: 12px; min-width: 0px; horizontal-stretch: 1; overflow: elide; }
            MathKeyButton { width: 72px; compact: true; label: root.expanded ? "收起键盘" : "展开键盘"; clicked => { root.expanded = !root.expanded; root.focus-requested(); } }
        }
        if root.expanded: HorizontalLayout {
            height: 32px;
            spacing: 6px;
            MathKeyButton { width: 72px; compact: true; label: root.selecting ? "选择中" : "选择"; checkable: true; checked <=> root.selecting; clicked => { root.focus-requested(); } }
            MathKeyButton { width: 56px; compact: true; label: "全选"; clicked => { root.activate("key:select-all"); } }
            MathKeyButton { width: 56px; compact: true; label: "复制"; clicked => { root.activate("key:copy"); } }
            MathKeyButton { width: 56px; compact: true; label: "剪切"; clicked => { root.activate("key:cut"); } }
            MathKeyButton { width: 56px; compact: true; label: "粘贴"; clicked => { root.activate("key:paste"); } }
            MathKeyButton { width: 56px; compact: true; label: "撤销"; clicked => { root.activate("key:undo"); } }
            MathKeyButton { width: 56px; compact: true; label: "重做"; clicked => { root.activate("key:redo"); } }
            MathKeyButton { width: 56px; compact: true; label: "清空"; clicked => { root.activate("key:clear"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.expanded && root.page != 2: grid := Rectangle {
            height: 184px;
            for item[index] in root.keys: MathKeyButton {
                x: Math.mod(index, 10) * (self.width + 6px);
                y: Math.floor(index / 10) * (self.height + 6px);
                width: (grid.width - 54px) / 10;
                height: (grid.height - 18px) / 4;
                label: item.label;
                description: item.description;
                primary: item.value == "key:submit";
                clicked => { root.activate(item.value); }
            }
        }
        if root.expanded && root.page == 2: Rectangle {
            height: 184px;
            Rectangle {
                x: 0px;
                y: 0px;
                height: 32px;
                width: parent.width;
                for section[index] in MathCatalog.sections: MathKeyButton {
                    x: index * (self.width + 4px);
                    width: (parent.width - (MathCatalog.sections.length - 1) * 4px) / MathCatalog.sections.length;
                    height: 32px;
                    compact: true;
                    label: section.title;
                    primary: root.active-category == index;
                    description: "显示" + section.title + "分类" + (root.active-category == index ? "，当前分类" : "");
                    clicked => {
                        root.category = index;
                        root.catalog-scroll-position = 0px;
                        root.focus-requested();
                    }
                }
            }
            ScrollView {
            x: 0px;
            y: 38px;
            width: parent.width;
            height: 102px;
            content-width: self.visible-width;
            content-y <=> root.catalog-scroll-position;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: Math.ceil(root.catalog-keys.length / 6) * 44px - 6px;
                    for item[index] in root.catalog-keys: MathKeyButton {
                        x: Math.mod(index, 6) * (self.width + 6px);
                        y: Math.floor(index / 6) * 44px;
                        width: (parent.width - 30px) / 6;
                        height: 38px;
                        compact: true;
                        math-label: true;
                        label: item.label;
                        description: item.description;
                        clicked => { root.activate(item.value); }
                    }
                }
            }
            }
            HorizontalLayout {
                y: 146px;
                height: 38px;
                spacing: 6px;
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "←"; description: "向左"; clicked => { root.activate("key:left"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "→"; description: "向右"; clicked => { root.activate("key:right"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "↑"; description: "向上"; clicked => { root.activate("key:up"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "↓"; description: "向下"; clicked => { root.activate("key:down"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "退出"; clicked => { root.activate("key:next"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "退格"; clicked => { root.activate("key:backspace"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "删除"; clicked => { root.activate("key:delete"); } }
                MathKeyButton { min-width: 48px; horizontal-stretch: 1; label: "提交"; primary: true; clicked => { root.activate("key:submit"); } }
            }
        }
    }
}

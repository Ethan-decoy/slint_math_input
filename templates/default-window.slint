import { Button, TextEdit, ScrollView, VerticalBox, HorizontalBox, SpinBox, Palette } from "std-widgets.slint";
import { MathEditor, MathView } from "../ui/smi.slint";

export component MathInputWindow inherits Window {
    title: "Slint Math Input — 数学键盘";
    preferred-width: 1080px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 600px;
    background: #f3f5f7;
    // The demonstration uses a light canvas, including its standard form controls.
    init => { Palette.color-scheme = ColorScheme.light; }
    in-out property <MathView> view;
    in-out property <string> latex-source;
    in-out property <string> draft-source;
    in-out property <string> status;
    in-out property <bool> details-visible: false;
    in-out property <int> keypad-page <=> math.keypad-page;
    in-out property <int> keypad-category <=> math.keypad-category;
    in-out property <bool> keypad-expanded <=> math.keypad-expanded;
    out property <bool> editor-has-focus: math.has-focus;
    callback typed(string);
    callback command(string, bool, bool, bool) -> bool;
    callback seek(float, float, bool);
    callback keypad(string, bool);
    callback insert-template(string);
    callback import-latex(string);
    callback save-draft();
    callback restore-draft(string);
    callback zoom(int);
    callback submitted();
    public function focus-editor() { math.focus(); }
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        Rectangle {
            height: 64px;
            background: #172c38;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                Text { text: "Slint Math Input"; font-size: 22px; font-weight: 600; color: white; vertical-alignment: center; }
                Text { text: "直接编辑公式 · 支持鼠标键盘"; color: #aac0cc; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalBox {
                    padding: 0px;
                    height: 32px;
                    Text { text: "数学表达式"; color: #526572; font-size: 13px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "字号"; color: #526572; }
                    SpinBox { value: 32; minimum: 18; maximum: 64; max-width: 100px; edited(value) => { root.zoom(value); } }
                    Button { text: "保存草稿"; clicked => { root.save-draft(); math.focus(); } }
                    Button { text: "恢复草稿"; enabled: root.draft-source != ""; clicked => { root.restore-draft(root.draft-source); math.focus(); } }
                    Button { text: root.details-visible ? "收起详情" : "LaTeX / 草稿"; clicked => { root.details-visible = !root.details-visible; } }
                }
                Text { text: "点击公式定位，点击下方按键输入；“选择”配合方向键扩展选区，“退出”返回上一层。"; color: #6a7a86; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                math := MathEditor {
                    preferred-height: 460px;
                    max-height: 560px;
                    vertical-stretch: 1;
                    view: root.view;
                    label: "数学表达式";
                    edited(text) => { root.typed(text); }
                    command(text,control,shift,alt) => { return root.command(text,control,shift,alt); }
                    seek(x,y,extend) => { root.seek(x,y,extend); }
                    key(value,extend) => { root.keypad(value,extend); }
                    submitted => { root.submitted(); }
                }
                Text { text: root.status; color: #2b626f; font-size: 12px; wrap: word-wrap; min-height: 20px; vertical-stretch: 0; }
                if root.details-visible: HorizontalBox {
                    padding: 0px;
                    spacing: 18px;
                    height: 190px;
                    VerticalBox {
                        padding: 0px;
                        Text { text: "LaTeX"; color: #526572; font-size: 12px; font-weight: 600; }
                        TextEdit { text <=> root.latex-source; font-family: "Consolas"; font-size: 14px; min-height: 100px; }
                        Button { text: "导入 LaTeX"; clicked => { root.import-latex(root.latex-source); math.focus(); } }
                    }
                    VerticalBox {
                        padding: 0px;
                        Text { text: "JSON 草稿 · 保留空位、光标和选区"; color: #526572; font-size: 12px; font-weight: 600; }
                        TextEdit { text <=> root.draft-source; font-family: "Consolas"; font-size: 12px; min-height: 100px; }
                        Button { text: "恢复 JSON 草稿"; clicked => { root.restore-draft(root.draft-source); math.focus(); } }
                    }
                }
            }
        }
    }
}
